<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/txtNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="Nombre del mecánico" />
        <TextView
            android:id="@+id/txtubi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ubicacion: mexico" />

        <TextView
            android:id="@+id/txtEspecialidad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Especialidad: Carro" />

        <RatingBar
            android:id="@+id/ratingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="0.5"
            android:isIndicator="true"
            android:layout_marginTop="6dp"
            android:progressTint="@color/yellow"
            android:secondaryProgressTint="@color/yellow"
            android:thumbTint="@color/yellow"/>

        <Button
            android:id="@+id/btnWhatsapp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WhatsApp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#25D366"
            android:textColor="@android:color/white"
            android:drawableStart="@drawable/ic_whatsapp"
            android:paddingHorizontal="16dp"/>




    </LinearLayout>

</androidx.cardview.widget.CardView>
